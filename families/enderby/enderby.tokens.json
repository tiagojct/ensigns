  "typography": { "sans": "Inter", "display": "Inter Display", "mono": "JetBrains Mono" },
  "design": {
    "projector": { "rooms": ["dark"] },
    "type": { "tick": "11px", "label": "12px", "body": "14px", "title": "16px", "figure": "22px", "leading": "1.25" },
    "stroke": { "series": "2px", "context": "1.5px", "axis": "1px", "grid": "1px", "outline": "1px", "focus": "3px" },
    "marker": { "size": "7px" },
    "markers": {
      "1": { "shape": "circle", "fill": "solid" },
      "2": { "shape": "square", "fill": "solid" },
      "3": { "shape": "triangle-up", "fill": "solid" },
      "4": { "shape": "diamond", "fill": "solid" },
      "5": { "shape": "circle", "fill": "open" },
      "6": { "shape": "square", "fill": "open" },
      "7": { "shape": "triangle-up", "fill": "open" },
      "8": { "shape": "diamond", "fill": "open" }
    },
    "lines": {
      "1": { "name": "solid", "dash": [] },
      "2": { "name": "dash", "dash": [8, 4] },
      "3": { "name": "dot", "dash": [2, 3] },
      "4": { "name": "dash-dot", "dash": [8, 3, 2, 3] },
      "5": { "name": "long-dash", "dash": [14, 4] },
      "6": { "name": "short-dash", "dash": [4, 3] },
      "7": { "name": "dash-dot-dot", "dash": [8, 3, 2, 3, 2, 3] },
      "8": { "name": "sparse-dot", "dash": [1, 5] }
    }
  },
  "pairs": [
    { "fg": "roles.text", "bg": "roles.bg", "kind": "text", "why": "body text" },
    { "fg": "roles.text-muted", "bg": "roles.bg", "kind": "text", "why": "captions and secondary text" },
    { "fg": "roles.text-subtle", "bg": "roles.bg", "kind": "text", "why": "footnotes and source lines" },
    { "fg": "roles.text", "bg": "roles.surface", "kind": "text", "why": "body text on a card" },
    { "fg": "roles.text-muted", "bg": "roles.surface", "kind": "text", "why": "secondary text on a card" },
    { "fg": "roles.link", "bg": "roles.bg", "kind": "text", "why": "link" },
    { "fg": "roles.link-hover", "bg": "roles.bg", "kind": "text", "why": "link on hover" },
    { "fg": "roles.on-button", "bg": "roles.button", "kind": "text", "why": "button label" },
    { "fg": "roles.text", "bg": "roles.selection", "kind": "text", "why": "selected text" },
    { "fg": "roles.accent", "bg": "roles.bg", "kind": "component", "why": "accent rule" },
    { "fg": "roles.focus", "bg": "roles.bg", "kind": "component", "why": "focus ring" },
    { "fg": "data.plot.text", "bg": "data.plot.background", "kind": "text", "why": "titles, tick labels and annotations" },
    { "fg": "data.plot.muted", "bg": "data.plot.background", "kind": "text", "why": "axis titles, source lines and muted annotations" },
    { "fg": "data.plot.text", "bg": "data.plot.panel", "kind": "text", "why": "labels drawn inside the panel" },
    { "fg": "data.plot.muted", "bg": "data.plot.panel", "kind": "text", "why": "muted labels drawn inside the panel" },
    { "fg": "data.plot.axis", "bg": "data.plot.background", "kind": "component", "why": "axis lines and ticks" },
    { "fg": "data.plot.outline", "bg": "data.plot.background", "kind": "component", "why": "outline of a mark below 3:1" },
    { "fg": "data.plot.focus", "bg": "data.plot.background", "kind": "component", "why": "the focus mark" }
  ],
  "rules": [
    {
      "id": "hue-belongs-to-data",
      "text": "The chrome has no data colour in it. Every hue that carries a value sits in a data scale, and no role, extra role or surface uses one.",
      "check": "group-not-in-chrome:cat-light,cat-dark,seq-pilot,seq-brass,seq-lagoon,div-blue-orange,div-teal-brass"
    },
    {
      "id": "brass-marks-the-interface",
      "text": "Brass is the interface accent and the focus ring. No other role takes its colour.",
      "check": "accent-only-in-roles:focus"
    },
    {
      "id": "no-red-green-axis",
      "text": "A diverging ramp never runs from red to green. Both ramps run between hues that stay apart under protan, deutan and tritan simulation.",
      "check": [
        "not-red-green:data.diverging.blue-orange.1,data.diverging.blue-orange.9",
        "not-red-green:data.diverging.teal-brass.1,data.diverging.teal-brass.9"
      ]
    },
    {
      "id": "focus-survives-grey",
      "text": "The focus colour differs from the context grey by at least 20 L*, so a highlighted series survives a greyscale copy.",
      "check": "lightness-gap:data.plot.focus,data.plot.context,20"
    },
    {
      "id": "links-hover-toward-the-page",
      "text": "A link is darker on hover in the light mode and lighter in the dark mode.",
      "check": "hover-direction"
    },
    {
      "id": "pale-marks-get-an-outline",
      "text": "A mark below 3:1 on the figure ground is drawn with data.plot.outline. The end of every sequential ramp that lies nearest the ground is such a mark."
    },
    {
      "id": "series-carry-markers",
      "text": "Every series carries the marker and the dash pattern of its number (design.markers and design.lines). In print, series five to eight are told apart by these and by direct labels, not by colour."
    },
    {
      "id": "categories-in-order",
      "text": "Categories are used in the order given. The first four are the most separable, in normal vision, under colour vision simulation and in greyscale."
    }
  ],
  "distinct": [
    {
      "id": "categorical",
      "set": "data.categorical",
      "min": 0.15,
      "for": ["projector"],
      "note": "All eight pairs keep 0.15 in OKLab under normal vision (Okabe-Ito: 0.156 with black in its set) and 0.06 under each simulation; the figure profile holds the set to Okabe-Ito's own minimum in each view. For projector the same pairs keep 0.08 after a flare of 0.02."
    },
    {
      "id": "categorical-first-four",
      "members": ["data.categorical.c1", "data.categorical.c2", "data.categorical.c3", "data.categorical.c4"],
      "for": ["print-grey"],
      "note": "The first four categories differ by at least 12 L* in both modes, so they survive a greyscale print."
    },
    {
      "id": "categorical-greyscale",
      "set": "data.categorical",
      "patterned": ["c5", "c6", "c7", "c8"],
      "for": ["print-grey"],
      "by": "Categories five to eight carry their own marker (open circle, square, triangle and diamond) and dash pattern from design.markers and design.lines, so a greyscale print separates them by shape and line style.",
      "note": "The eight-member set for print-grey. Pairs that include a patterned member are exempt, which leaves the pairs among the first four."
    }
  ],
  "targets": { "exclude": ["vscode", "zed", "neovim", "terminals"] }
}
