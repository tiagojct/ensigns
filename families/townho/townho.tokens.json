  "rules": [
    {
      "id": "diff-not-red-green",
      "text": "Added and removed diff roles must not use red against green alone.",
      "check": "not-red-green:extra.diff-added,extra.diff-removed"
    },
    {
      "id": "insert-delete-not-red-green",
      "text": "Insert and delete inks must not use red against green alone.",
      "check": "not-red-green:extra.insert,extra.delete"
    },
    {
      "id": "diff-lightness-gap",
      "text": "Added and removed diff roles differ by at least 12 in lightness.",
      "check": "lightness-gap:extra.diff-added,extra.diff-removed,12"
    },
    {
      "id": "meaning-not-by-colour-alone",
      "text": "Meaning never by colour alone in exports: labels and legends accompany highlights."
    },
    {
      "id": "decoration-rules",
      "text": "Insertions are underlined and deletions are struck through."
    }
