    {"fg":"roles.text-muted","bg":"roles.surface","kind":"text","why":"captions on a panel"},
    {"fg":"roles.text","bg":"roles.surface-raised","kind":"text","why":"text on a raised card or a chart panel"},
    {"fg":"roles.text-muted","bg":"roles.surface-raised","kind":"text","why":"axis labels and notes on a chart panel"},
    {"fg":"roles.link","bg":"roles.bg","kind":"text","why":"a web address on the ground"},
    {"fg":"roles.link-hover","bg":"roles.bg","kind":"text","why":"a web address under the pointer"},
