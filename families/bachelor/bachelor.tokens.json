    {"fg":"roles.on-button","bg":"roles.button","kind":"text","why":"text on a button"},
    {"fg":"roles.accent","bg":"roles.bg","kind":"component","why":"a rule or a marker in the accent"},
    {"fg":"roles.border","bg":"roles.bg","kind":"component","why":"rules and chart axes"},
    {"fg":"roles.focus","bg":"roles.bg","kind":"component","why":"the focus ring"},
    {"fg":"extra.ink-red","bg":"accents.red","kind":"text","why":"body text on the red field; titles use the same ink"},
    {"fg":"extra.ink-orange","bg":"accents.orange","kind":"text","why":"body text on the orange field; titles use the same ink"},
    {"fg":"extra.ink-yellow","bg":"accents.yellow","kind":"text","why":"body text on the yellow field; titles use the same ink"},
    {"fg":"extra.ink-green","bg":"accents.green","kind":"text","why":"body text on the green field; titles use the same ink"},
    {"fg":"extra.ink-cyan","bg":"accents.cyan","kind":"text","why":"body text on the cyan field; titles use the same ink"},
    {"fg":"extra.ink-blue","bg":"accents.blue","kind":"text","why":"body text on the blue field; titles use the same ink"},
    {"fg":"extra.ink-violet","bg":"accents.violet","kind":"text","why":"body text on the violet field; titles use the same ink"},
    {"fg":"extra.ink-magenta","bg":"accents.magenta","kind":"text","why":"body text on the magenta field; titles use the same ink"}
  ],
  "rules": [
    {
      "id": "two-bands",
      "text": "A field that carries body text sits in one of two luminance bands: deep, with white ink, or bright, with a dark ink. Nothing between them carries body text in a lit room, so no flag is placed there.",
      "check": ["lightness-gap:accents.red,accents.orange,35","lightness-gap:accents.magenta,accents.green,35"]
    },
    {
      "id": "own-ink",
      "text": "Each field carries its own ink, extra.ink-<flag>: white on the four deep fields, a dark tint of the field's hue on the four bright ones. Text on a field is set in that ink and in no other."
    },
    {
      "id": "one-accent",
      "text": "The accent is one flag in each mode, blue in Holiday apparel and yellow in Brazen lamp. Link, button and focus take it, and no other core or extra role does.",
      "check": "accent-only-in-roles:link,button,focus"
    },
    {
      "id": "pattern-in-print",
      "text": "Every flag has a pattern token. In print in grey the three flags that lightness cannot tell from another (green, cyan and magenta) are told apart by their pattern, and the other five by lightness."
    },
    {
      "id": "marks-outlined",
      "text": "A chart mark is a flag with an outline in the text colour. No flag keeps 3:1 against both grounds, so the outline carries the mark against whichever ground it is on."
    },
    {
      "id": "heavy-type",
      "text": "Text on a field is set at weight 500 or more, titles at 800 or 900. A thin stroke blurs away at a distance sooner than a thick one."
    }
  ],
  "distinct": [
    {
      "id": "fields",
      "set": "accents",
      "min": 0.1,
      "for": ["projector"],
      "note": "The eight flags, told apart by colour alone: under normal vision, under each colour vision simulation and after the flare of a dark room and of a lit room. No pair is reinforced or patterned."
    },
    {
      "id": "fields-print",
      "set": "accents",
      "for": ["print-grey"],
      "patterned": ["green","cyan","magenta"],
      "by": "the flag's pattern token (design.pattern): a cross on green, checks on cyan, quarters on magenta",
      "note": "The same eight flags for print in grey. Five stand on their own lightness, 12 L* or more from each other. The other three sit at the lightness of one of the five, so each carries a pattern of its own. Colour vision results repeat those of fields."
    }
  ],
  "targets": {
    "exclude": ["vscode","zed","neovim","terminals"]
  }
}
