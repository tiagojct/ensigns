  "pairs": [
    {"fg":"roles.text","bg":"roles.bg","kind":"text","why":"body text on the slide ground"},
    {"fg":"roles.text-muted","bg":"roles.bg","kind":"text","why":"captions and notes on the ground"},
    {"fg":"roles.text-subtle","bg":"roles.bg","kind":"large","why":"quiet labels, set at title size only"},
