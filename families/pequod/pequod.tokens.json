  "rules": [
    {
      "id": "crew",
      "text": "The accents are the crew of the Pequod. Each keeps its name and has a light and a dark value."
    },
    {
      "id": "warm-to-cool",
      "text": "The Log scale runs from warm paper to cool ink. The hue turns between Log 500 and Log 600, so it is a warm-to-cool scale and not a sequential colormap."
    }
  ],
