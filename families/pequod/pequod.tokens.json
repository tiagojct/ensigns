  "distinct": [
    {
      "id": "crew-dark",
      "set": "accents",
      "modes": ["dark"],
      "min": 0.0879,
      "reinforced": [["ishmael", "tashtego"], ["ahab", "tashtego"]],
      "by": "token shape and position in code: strings are quoted, keywords are fixed words, comments are set in italic",
      "note": "The brief: the minimum pairwise OKLab distance among the crew in each mode must not fall below the original. The floor is the original minimum, Ishmael and Tashtego."
    },
    {
      "id": "crew-light",
      "set": "accents",
      "modes": ["light"],
      "min": 0.1124,
      "reinforced": [["ishmael", "tashtego"], ["ahab", "pip"], ["pip", "stubb"], ["ahab", "tashtego"], ["ahab", "daggoo"], ["starbuck", "tashtego"]],
      "by": "token shape and position in code: strings are quoted, numbers are digits, keywords are fixed words, parameters sit in signatures and calls, comments are set in italic",
      "note": "The floor is the original minimum, Ishmael and Tashtego. Ahab and Daggoo (protan) and Starbuck and Tashtego (tritan) joined the list when the corrections darkened the light crew to reach AA; the original had five pairs, the corrected set has seven."
    },
    {
      "id": "syntax-hues",
      "set": "syntax-hues",
      "aliases": [
        ["constant","decorator"]
      ],
      "cvd": "report",
      "note": "The crew sets above carry the CVD gate for these colours; this set reports the same pairs as seen through the syntax roles."
    },
    {
      "id": "ansi-hues",
      "set": "ansi-hues",
      "cvd": "report",
      "note": "Terminals give no way to reinforce a hue, so CVD results for the six hue slots are warnings. The normal-vision distance is a gate."
    }
  ]
