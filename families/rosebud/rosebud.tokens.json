  "rules": [
    {
      "id": "accent-marks-interaction",
      "text": "Accent marks interaction only: links, current item, selection, accent rules. Never severity, never decoration."
    },
    {
      "id": "status-achromatic",
      "text": "Status is achromatic. Severity is carried by border weight, edge style and fill density, plus an icon and explicit copy."
    },
    {
      "id": "data-and-chrome-apart",
      "text": "The data sweep never appears in interface chrome, and the interface accent never appears in a chart."
    },
    {
      "id": "functional-hues-in-content",
      "text": "Functional hues exist for terminal and editor content only: ANSI slots, diffs, diagnostics. Never interface chrome."
    }
  ]
