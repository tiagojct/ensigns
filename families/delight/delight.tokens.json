      ]
    },
    {
      "id": "text-high-contrast",
      "text": "Every declared text pair reaches at least 7:1 contrast in both modes."
    },
    {
      "id": "photocopy-sturdy",
      "text": "Lines and borders avoid hairlines below 1 pt to survive photocopies and e-ink displays."
    }
