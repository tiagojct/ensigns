{
  "$schema": "../../schema/family.schema.json",
  "meta": {
    "id": "rachel",
    "name": "Rachel",
    "version": "0.1.0",
    "chapter": 128,
    "chapterTitle": "The Pequod Meets the Rachel",
    "quote": "kindling a fire in her try-pots for a beacon",
    "quotes": [
      {"chapter": "Epilogue", "text": "It was the devious-cruising Rachel, that in her retracing search after her missing children, only found another orphan."},
      {"chapter": 128, "text": "till daylight"},
      {"chapter": 128, "text": "this ship that so wept with spray"},
      {"chapter": 128, "text": "three tall cherry trees"}
    ],
    "tagline": "A warm paper ground, one blue for action, three gentle status levels that always carry an icon and words.",
    "goal": "Patient-facing apps, leaflets, consent forms and health education, for older adults, people with low vision and people with low health literacy.",
    "environments": ["aged-eye","sunlight","print-grey","cvd"],
    "licence": {
      "tokens": "CC-BY-4.0",
      "code": "MIT"
    }
  },
